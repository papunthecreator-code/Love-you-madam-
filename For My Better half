<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday, My Better Half ❤️</title>
    
    <!-- Canvas Confetti Library for Grand Finale -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0b1d15;
            --accent-gold: #e5c158;
            --text-light: #f5f5f5;
            --card-bg: rgba(20, 48, 36, 0.85);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
            position: relative;
        }

        /* Floating Background Canvas */
        #heartCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Music Button */
        .audio-control {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 1000;
            background: linear-gradient(135deg, #e5c158, #b8860b);
            color: #000;
            border: none;
            padding: 12px 22px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(229, 193, 88, 0.4);
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.3s ease;
        }

        .audio-control:hover {
            transform: scale(1.08);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            background: linear-gradient(180deg, rgba(11, 29, 21, 0.5) 0%, rgba(11, 29, 21, 0.95) 100%), 
                        url('1000007565.jpg') center/cover no-repeat;
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-family: 'Great Vibes', cursive;
            font-size: 4.2rem;
            color: var(--accent-gold);
            text-shadow: 0 0 15px rgba(229, 193, 88, 0.5);
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 1.2rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #d1d1d1;
        }

        .scroll-hint {
            margin-top: 40px;
            font-size: 0.9rem;
            opacity: 0.7;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }

        /* Gallery Section */
        .section-title {
            text-align: center;
            font-size: 2.8rem;
            color: var(--accent-gold);
            margin: 60px 20px 30px;
            font-family: 'Great Vibes', cursive;
        }

        .gallery {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            position: relative;
            z-index: 2;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid rgba(229, 193, 88, 0.25);
            border-radius: 16px;
            overflow: hidden;
            backdrop-filter: blur(5px);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(229, 193, 88, 0.25);
        }

        .card-img-wrapper {
            width: 100%;
            height: 380px;
            overflow: hidden;
        }

        .card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .card:hover img {
            transform: scale(1.06);
        }

        .card-caption {
            padding: 20px;
            text-align: center;
            font-style: italic;
            color: var(--accent-gold);
            font-size: 1.05rem;
            line-height: 1.5;
        }

        /* Love Letter Section */
        .letter-container {
            max-width: 700px;
            margin: 80px auto 40px;
            padding: 40px 30px;
            background: var(--card-bg);
            border-radius: 20px;
            border: 1px solid rgba(229, 193, 88, 0.3);
            position: relative;
            z-index: 2;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        }

        .letter-container h2 {
            color: var(--accent-gold);
            font-family: 'Great Vibes', cursive;
            font-size: 2.5rem;
            margin-bottom: 20px;
        }

        .letter-body {
            font-size: 1.1rem;
            line-height: 1.9;
            color: #e0e0e0;
            min-height: 120px;
        }

        /* Surprise Button Section */
        .surprise-section {
            text-align: center;
            margin: 50px 0 100px;
            position: relative;
            z-index: 2;
        }

        .surprise-btn {
            background: linear-gradient(135deg, #e5c158, #d4af37);
            color: #0d1f18;
            border: none;
            padding: 16px 36px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(229, 193, 88, 0.4);
            transition: all 0.3s ease;
        }

        .surprise-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 12px 30px rgba(229, 193, 88, 0.6);
        }

        /* Modal Pop-up */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--card-bg);
            border: 2px solid var(--accent-gold);
            padding: 40px;
            border-radius: 20px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            position: relative;
            animation: popIn 0.4s ease;
        }

        @keyframes popIn {
            from { transform: scale(0.7); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .close-modal {
            position: absolute;
            top: 15px;
            right: 20px;
            color: var(--accent-gold);
            font-size: 1.8rem;
            cursor: pointer;
        }

        footer {
            text-align: center;
            padding: 20px;
            font-size: 0.9rem;
            color: #888;
            position: relative;
            z-index: 2;
        }
    </style>
</head>
<body>

    <!-- Canvas for Floating Hearts -->
    <canvas id="heartCanvas"></canvas>

    <!-- Audio Element -->
    <audio id="bgSong" loop src="song.mp3"></audio>

    <!-- Music Control Button -->
    <button class="audio-control" onclick="toggleAudio()">
        <span id="musicIcon">🎵</span> <span id="musicText">Play Our Song</span>
    </button>

    <!-- Hero Banner -->
    <section class="hero">
        <h1>Happy Birthday, My Better Half ❤️</h1>
        <p>29th July 2026</p>
        <div class="scroll-hint">Scroll down for your surprise 👇</div>
    </section>

    <!-- Photo Gallery -->
    <h2 class="section-title">Moments That Take My Breath Away</h2>
    <section class="gallery">
        <div class="card">
            <div class="card-img-wrapper">
                <img src="1000007566.jpg" alt="Teal Saree Selfie">
            </div>
            <div class="card-caption">
                "That smile and jhumka — my favorite view forever."
            </div>
        </div>

        <div class="card">
            <div class="card-img-wrapper">
                <img src="1000007567.jpg" alt="Dark Sequined Saree">
            </div>
            <div class="card-caption">
                "Effortlessly elegant, sparkling brighter than any star."
            </div>
        </div>

        <div class="card">
            <div class="card-img-wrapper">
                <img src="1000007568.jpg" alt="Striped Saree Candid">
            </div>
            <div class="card-caption">
                "Your laughter is proof that magic truly exists."
            </div>
        </div>
    </section>

    <!-- Heartfelt Letter Section -->
    <section class="letter-container">
        <h2>To My Life's Greatest Blessing,</h2>
        <div class="letter-body" id="typewriterText"></div>
    </section>

    <!-- Interactive Grand Finale Button -->
    <section class="surprise-section">
        <button class="surprise-btn" onclick="triggerSurprise()">Click For Your Birthday Surprise 🎁</button>
    </section>

    <!-- Surprise Modal -->
    <div class="modal" id="surpriseModal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h2 style="color: var(--accent-gold); font-family: 'Great Vibes', cursive; font-size: 3rem; margin-bottom: 15px;">I Love You! ❤️</h2>
            <p style="line-height: 1.6; font-size: 1.1rem; color: #fff;">
                You bring so much light, elegance, and happiness into my world every single day. Here’s to celebrating YOU today and making endless beautiful memories together.
            </p>
        </div>
    </div>

    <footer>Made with ❤️ specially for 29-07-2026</footer>

    <script>
        // Audio Toggle
        function toggleAudio() {
            const audio = document.getElementById("bgSong");
            const icon = document.getElementById("musicIcon");
            const text = document.getElementById("musicText");

            if (audio.paused) {
                audio.play();
                icon.innerText = "⏸️";
                text.innerText = "Pause Song";
            } else {
                audio.pause();
                icon.innerText = "🎵";
                text.innerText = "Play Our Song";
            }
        }

        // Typewriter Effect
        const letterText = "Thank you for bringing so much warmth, grace, and pure joy into my life. Every smile of yours turns an ordinary day into something magical. Today and every day, I just want to see you happy. Happy Birthday, my love! ✨";
        let index = 0;
        let typed = false;

        function typeWriter() {
            if (index < letterText.length) {
                document.getElementById("typewriterText").innerHTML += letterText.charAt(index);
                index++;
                setTimeout(typeWriter, 40);
            }
        }

        // Trigger typewriter when user scrolls to the letter
        window.addEventListener('scroll', () => {
            const letterPos = document.querySelector('.letter-container').getBoundingClientRect().top;
            const screenPos = window.innerHeight / 1.3;
            if (letterPos < screenPos && !typed) {
                typed = true;
                typeWriter();
            }
        });

        // Surprise Modal & Confetti Burst
        function triggerSurprise() {
            document.getElementById('surpriseModal').style.display = 'flex';
            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 }
            });
        }

        function closeModal() {
            document.getElementById('surpriseModal').style.display = 'none';
        }

        // Floating Gold Hearts Background Animation
        const canvas = document.getElementById('heartCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const hearts = [];
        for (let i = 0; i < 25; i++) {
            hearts.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 12 + 8,
                speed: Math.random() * 1.5 + 0.5,
                opacity: Math.random() * 0.6 + 0.2
            });
        }

        function drawHeart(x, y, size, opacity) {
            ctx.save();
            ctx.globalAlpha = opacity;
            ctx.fillStyle = '#e5c158';
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.bezierCurveTo(x - size / 2, y - size / 2, x - size, y + size / 3, x, y + size);
            ctx.bezierCurveTo(x + size, y + size / 3, x + size / 2, y - size / 2, x, y);
            ctx.fill();
            ctx.restore();
        }

        function animateHearts() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            hearts.forEach(heart => {
                heart.y -= heart.speed;
                if (heart.y < -20) {
                    heart.y = canvas.height + 20;
                    heart.x = Math.random() * canvas.width;
                }
                drawHeart(heart.x, heart.y, heart.size, heart.opacity);
            });
            requestAnimationFrame(animateHearts);
        }
        animateHearts();

        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    </script>
</body>
</html>
